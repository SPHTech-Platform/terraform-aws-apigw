{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSyntheticRoleAccess",
      "Effect": "Allow",
      "Action": "execute-api:Invoke",
      "Resource": "arn:aws:execute-api:ap-southeast-1:123456789012:*/*/*/*",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/synthetic-test-role"
      }
    }
  ]
}